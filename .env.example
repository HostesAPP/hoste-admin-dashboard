# Admin Dashboard Environment Variables
# Copy this file to .env.local and update with your values

# ============================================
# Admin Authentication Configuration
# ============================================

# Development Admin Token
# This token is used for authenticating admin API requests
# Set this to a secure token value for development
# Supported headers: X-Dev-Admin-Token, X-Admin-Token, Authorization (Bearer scheme)
ADMIN_DEV_TOKEN=your_dev_admin_token_here

# Optional: Public version if needed (not recommended for sensitive data)
NEXT_PUBLIC_ADMIN_DEV_TOKEN=

# ============================================
# API Configuration
# ============================================

# Backend API URL (when backend is ready)
NEXT_PUBLIC_API_URL=http://localhost:3001
API_SECRET_KEY=

# ============================================
# Database Configuration (when applicable)
# ============================================

DATABASE_URL=

# ============================================
# Feature Flags
# ============================================

NEXT_PUBLIC_ENABLE_DEV_MODE=true
